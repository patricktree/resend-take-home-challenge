{
  "name": "@resend-challenge/cli",
  "private": true,
  "description": "The resend-challenge CLI for Agents",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "start": "node ./src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "turbo:build": "del-cli --dot=true \"dist/types\" \"dist/tsconfig.build.tsbuildinfo\" && tsc --build ./tsconfig.json && rolldown --config ./rolldown.config.ts && node -e \"fs.chmodSync('bundle/resend-challenge.mjs', 0o755)\"",
    "turbo:lint": "oxlint .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix",
    "turbo:test": "pnpm run test"
  },
  "dependencies": {
    "@commander-js/extra-typings": "~15.0.0",
    "@resend-challenge/api.client": "workspace:*",
    "@resend-challenge/api.routes": "workspace:*",
    "commander": "~15.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@patricktree-stack/config-typescript": "workspace:*",
    "@patricktree-stack/config-vitest": "workspace:*",
    "@resend-challenge/config-oxlint": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "jsonc-parser": "^3.3.1",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
