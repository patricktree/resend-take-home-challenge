{
  "name": "@draft-approval/cli",
  "private": true,
  "description": "The draft-approval CLI for Agents",
  "bin": {
    "draft-approval": "./src/cli.ts"
  },
  "files": [
    "src/**"
  ],
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#test/*.ts": "./test/*.ts"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "start": "node ./src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "turbo:build": "prepare-declaration-build --declaration-output-dir ./dist/types --build-info-file ./dist/tsconfig.build.tsbuildinfo --source-package-json ./src/package.json && tsc --build ./tsconfig.json",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix",
    "turbo:test": "pnpm run test"
  },
  "dependencies": {
    "@commander-js/extra-typings": "~15.0.0",
    "@draft-approval/api.client": "workspace:*",
    "@draft-approval/api.routes": "workspace:*",
    "commander": "~15.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@draft-approval/config-oxlint": "workspace:*",
    "@draft-approval/prepare-declaration-build": "workspace:*",
    "@patricktree-stack/config-typescript": "workspace:*",
    "@patricktree-stack/config-vitest": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "jsonc-parser": "^3.3.1",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
