{
  "name": "@resend-challenge/cloudflare-worker",
  "private": true,
  "description": "The Worker entry: fetch (API), queue and scheduled handlers, Wrangler and Vite configuration, integration tests",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "cf-typegen": "wrangler types --include-env=false worker-configuration.d.ts",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\" \".wrangler\"",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "pnpm run migrations:apply:local && vite",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "migrations:apply:local": "wrangler d1 migrations apply DB --local",
    "migrations:apply:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "turbo:build": "del-cli --dot=true \"dist/types\" \"dist/tsconfig.build.tsbuildinfo\" && tsc --build ./tsconfig.json && vite build",
    "turbo:cf-typegen": "pnpm run cf-typegen",
    "turbo:lint": "oxlint .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix",
    "turbo:test": "pnpm run test"
  },
  "dependencies": {
    "@resend-challenge/api.server": "workspace:*",
    "@resend-challenge/drafts": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:web-app",
    "@modelcontextprotocol/client": "catalog:mcp",
    "@patricktree-stack/config-typescript": "workspace:*",
    "@patricktree-stack/config-vitest": "workspace:*",
    "@resend-challenge/api.client": "workspace:*",
    "@resend-challenge/api.routes": "workspace:*",
    "@resend-challenge/config-oxlint": "workspace:*",
    "@resend-challenge/resend-stub": "workspace:*",
    "@resend-challenge/review-ui": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "temporal-polyfill": "^1.0.6",
    "typescript": "catalog:",
    "vite": "catalog:web-app",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "zod": "^4.6.5"
  }
}
