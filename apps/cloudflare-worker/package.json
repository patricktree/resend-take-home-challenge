{
  "name": "@draft-approval/cloudflare-worker",
  "private": true,
  "description": "The Worker entry: fetch (API), queue and scheduled handlers, Wrangler and Vite configuration, integration tests",
  "files": [
    "src/**"
  ],
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#test/*.ts": "./test/*.ts"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "cf-typegen": "wrangler types --include-env=false worker-configuration.d.ts",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\" \".wrangler\"",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "pnpm run migrations:apply:local && vite",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "migrations:apply:local": "wrangler d1 migrations apply DB --local",
    "migrations:apply:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "turbo:build": "prepare-declaration-build --declaration-output-dir ./dist/types --build-info-file ./dist/tsconfig.build.tsbuildinfo --source-package-json ./src/package.json && tsc --build ./tsconfig.json && vite build",
    "turbo:cf-typegen": "pnpm run cf-typegen",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix",
    "turbo:test": "pnpm run test"
  },
  "dependencies": {
    "@draft-approval/api.server": "workspace:*",
    "@draft-approval/drafts": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:web-app",
    "@draft-approval/api.client": "workspace:*",
    "@draft-approval/api.routes": "workspace:*",
    "@draft-approval/config-oxlint": "workspace:*",
    "@draft-approval/prepare-declaration-build": "workspace:*",
    "@modelcontextprotocol/client": "catalog:mcp",
    "@patricktree-stack/config-typescript": "workspace:*",
    "@patricktree-stack/config-vitest": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "temporal-polyfill": "^1.0.6",
    "typescript": "catalog:",
    "vite": "catalog:web-app",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "zod": "^4.6.5"
  }
}
