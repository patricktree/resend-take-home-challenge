// The test runtime's Wrangler config. It lives in `test/` rather than next to `wrangler.jsonc` because
// Wrangler loads `.dev.vars` and `.env` files from the config's directory: a developer's local
// `.dev.vars` must never change what the integration tests see.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "draft-approval-test",
  "main": "worker.ts",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-08-18",
  // A small fixed stand-in for the built Review UI, so the `/app` tests need no build.
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "draft-approval",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../../libs/drafts/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "REVISION_BODIES",
      "bucket_name": "draft-approval-revision-bodies",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "SEND_QUEUE",
        "queue": "draft-approval-send",
      },
    ],
  },
  // AGENT_TOKEN and REVIEWER_TOKEN come from the `useWorker()` fixture (test/use-worker.ts).
  "vars": {
    "PUBLIC_BASE_URL": "https://resend-challenge.patricktree.me",
    "RESEND_FROM": "drafts@resend-challenge.patricktree.me",
    // Unreachable on purpose (discard port): tests never call Resend, and tests that send point it
    // at their own Resend stub.
    "RESEND_BASE_URL": "http://127.0.0.1:9",
    "LOCAL_DEVELOPMENT": "true",
  },
  "env": {
    // The one test that proves real Queue delivery selects this environment (`useWorker()` with
    // `shouldConsumeSendQueue`). Every other test delivers batches through `POST /__test/queue`, so
    // the default environment has no consumer that could race them. Wrangler does not inherit
    // bindings and vars into an environment, so they are repeated here.
    "send-queue-delivery": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "draft-approval",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../../libs/drafts/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "REVISION_BODIES",
          "bucket_name": "draft-approval-revision-bodies",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "SEND_QUEUE",
            "queue": "draft-approval-send",
          },
        ],
        "consumers": [
          // The production consumer's settings (wrangler.jsonc).
          {
            "queue": "draft-approval-send",
            "max_concurrency": 1,
            "max_batch_size": 8,
            "max_batch_timeout": 1,
            "max_retries": 100,
            "dead_letter_queue": "draft-approval-send-dlq",
          },
        ],
      },
      "vars": {
        "PUBLIC_BASE_URL": "https://resend-challenge.patricktree.me",
        "RESEND_FROM": "drafts@resend-challenge.patricktree.me",
        "RESEND_BASE_URL": "http://127.0.0.1:9",
        "LOCAL_DEVELOPMENT": "true",
      },
    },
  },
}
