{
  "name": "@resend-challenge/review-ui",
  "private": true,
  "description": "The Review UI: a React 19 SPA (TanStack Router and Query) served under /app",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    "./package.json": "./package.json",
    "./vite": "./vite.shared.ts"
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "turbo:build": "prepare-declaration-build --declaration-output-dir ./dist/types --build-info-file ./dist/tsconfig.build.tsbuildinfo --source-package-json ./src/package.json && tsc --build ./tsconfig.json && vite build",
    "turbo:lint": "oxlint .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix",
    "turbo:test": "pnpm run test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@linaria/core": "^8.2.0",
    "@resend-challenge/api.client": "workspace:*",
    "@resend-challenge/api.routes": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "react": "catalog:web-app",
    "react-dom": "catalog:web-app",
    "temporal-polyfill": "^1.0.6"
  },
  "devDependencies": {
    "@patricktree-stack/config-typescript": "workspace:*",
    "@patricktree-stack/config-vitest": "workspace:*",
    "@patricktree-stack/config-wyw-in-js": "workspace:*",
    "@resend-challenge/config-oxlint": "workspace:*",
    "@resend-challenge/prepare-declaration-build": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:web-app",
    "@types/react-dom": "catalog:web-app",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:web-app",
    "@vitest/coverage-v8": "catalog:",
    "@wyw-in-js/vite": "catalog:web-app",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:web-app",
    "vitest": "catalog:"
  }
}
