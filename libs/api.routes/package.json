{
  "name": "@resend-challenge/api.routes",
  "private": true,
  "description": "The HTTP API contract: OpenAPI routes, Zod schemas, the error envelope and the local tokens",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "turbo:build": "prepare-declaration-build --declaration-output-dir ./dist/types --build-info-file ./dist/tsconfig.build.tsbuildinfo --source-package-json ./src/package.json && tsc --build ./tsconfig.json",
    "turbo:lint": "oxlint .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:hono",
    "hono": "catalog:hono",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@patricktree-stack/config-typescript": "workspace:*",
    "@resend-challenge/config-oxlint": "workspace:*",
    "@resend-challenge/prepare-declaration-build": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
