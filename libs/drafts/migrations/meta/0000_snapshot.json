        "drafts_sending_status_values": {
          "name": "drafts_sending_status_values",
          "value": "\"drafts\".\"sending_status\" IN ('NOT_SENT', 'QUEUED', 'SENT', 'FAILED')"
        },
        "drafts_failure_reason_values": {
          "name": "drafts_failure_reason_values",
          "value": "\"drafts\".\"failure_reason\" IS NULL OR \"drafts\".\"failure_reason\" IN ('REJECTED_BY_RESEND', 'OUTCOME_UNKNOWN')"
        },
        "drafts_not_sent_exactly_without_approval": {
          "name": "drafts_not_sent_exactly_without_approval",
          "value": "(\"drafts\".\"sending_status\" = 'NOT_SENT') = (\"drafts\".\"approved_revision_id\" IS NULL)"
        },
        "drafts_approved_revision_is_latest": {
          "name": "drafts_approved_revision_is_latest",
          "value": "\"drafts\".\"approved_revision_id\" IS NULL OR \"drafts\".\"approved_revision_id\" = \"drafts\".\"latest_revision_id\""
        },
        "drafts_outbox_complete_exactly_with_approval": {
          "name": "drafts_outbox_complete_exactly_with_approval",
          "value": "(\"drafts\".\"approved_at\" IS NULL) = (\"drafts\".\"approved_revision_id\" IS NULL)\n        AND (\"drafts\".\"idempotency_key\" IS NULL) = (\"drafts\".\"approved_revision_id\" IS NULL)\n        AND (\"drafts\".\"outgoing_email\" IS NULL) = (\"drafts\".\"approved_revision_id\" IS NULL)\n        AND (\"drafts\".\"deadline\" IS NULL) = (\"drafts\".\"approved_revision_id\" IS NULL)"
        },
        "drafts_email_id_exactly_when_sent": {
          "name": "drafts_email_id_exactly_when_sent",
          "value": "(\"drafts\".\"email_id\" IS NOT NULL) = (\"drafts\".\"sending_status\" = 'SENT')"
        },
        "drafts_failure_reason_exactly_when_failed": {
          "name": "drafts_failure_reason_exactly_when_failed",
          "value": "(\"drafts\".\"failure_reason\" IS NOT NULL) = (\"drafts\".\"sending_status\" = 'FAILED')"
        },
        "drafts_resend_error_only_when_rejected_by_resend": {
          "name": "drafts_resend_error_only_when_rejected_by_resend",
          "value": "\"drafts\".\"failure_reason\" IS 'REJECTED_BY_RESEND'\n        OR (\"drafts\".\"resend_error_name\" IS NULL AND \"drafts\".\"resend_error_message\" IS NULL)"
        }
      }
