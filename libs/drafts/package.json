{
  "name": "@draft-approval/drafts",
  "private": true,
  "description": "The Draft domain: storage, use cases and the Send pipeline (Queue consumer, DLQ consumer, Send reconciler)",
  "files": [
    "src/**",
    "migrations/**"
  ],
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/worker-handlers.d.ts",
      "default": "./src/worker-handlers.ts"
    }
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "cf-typegen": "wrangler types --config ../../apps/cloudflare-worker/wrangler.jsonc --include-env=false worker-configuration.d.ts",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "turbo:build": "prepare-declaration-build --declaration-output-dir ./dist/types --build-info-file ./dist/tsconfig.build.tsbuildinfo --source-package-json ./src/package.json && tsc --build ./tsconfig.json",
    "turbo:cf-typegen": "pnpm run cf-typegen",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix"
  },
  "devDependencies": {
    "@draft-approval/config-oxlint": "workspace:*",
    "@draft-approval/prepare-declaration-build": "workspace:*",
    "@patricktree-stack/config-typescript": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
