{
  "name": "@draft-approval/monorepo-root",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run turbo:build",
    "build:watch": "turbo watch turbo:build",
    "cf-typegen": "turbo run turbo:cf-typegen",
    "clean": "pnpm run --parallel clean && pnpm exec del-cli \"**/node_modules\" \"**/.turbo\"",
    "declutter": "knip",
    "dev": "pnpm --filter '@draft-approval/cloudflare-worker' run dev",
    "draft-approval": "node apps/cli/src/cli.ts",
    "fix": "pnpm run format && pnpm run lint:fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "pnpm:devPreinstall": "sh ./preinstall.sh",
    "postinstall": "sh ./postinstall.sh",
    "secrets:generate": "pnpm --filter '@draft-approval/secrets-generate' run start",
    "seed": "pnpm --filter '@draft-approval/seed' run start",
    "test": "turbo run turbo:test",
    "test:e2e": "pnpm --filter '@draft-approval/e2e' run test:e2e",
    "test:e2e:update": "pnpm --filter '@draft-approval/e2e' run test:e2e:update",
    "test:resend-live": "pnpm --filter '@draft-approval/resend-stub' run test:resend-live",
    "validate": "pnpm run validate:fast && pnpm run validate:extended",
    "validate:extended": "pnpm run test:e2e",
    "validate:fast": "pnpm run format:check && pnpm run declutter && turbo run turbo:build turbo:lint turbo:test --output-logs=errors-only",
    "validate:update-snapshots": "pnpm run validate:fast && pnpm run test:e2e:update"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@patricktree-stack/config-oxfmt": "workspace:*",
    "del-cli": "^8.0.1",
    "knip": "^6.41.0",
    "oxfmt": "catalog:",
    "turbo": "^2.11.7"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "pnpm": "12.11.2"
  },
  "packageManager": "pnpm@12.11.2"
}
