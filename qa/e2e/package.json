{
  "name": "@draft-approval/e2e",
  "private": true,
  "description": "Playwright e2e tests of the review flow",
  "type": "module",
  "imports": {
    "#test-e2e/*.ts": "./test-e2e/*.ts"
  },
  "scripts": {
    "clean": "del-cli --dot=true \"*.tsbuildinfo\" \"playwright-output\"",
    "test:e2e": "turbo run turbo:build --filter=@draft-approval/e2e... --output-logs=errors-only && playwright test",
    "test:e2e:ui": "PWDEBUG=1 playwright test --ui",
    "turbo:build": "tsc --build ./tsconfig.json",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix"
  },
  "devDependencies": {
    "@draft-approval/api.client": "workspace:*",
    "@draft-approval/api.routes": "workspace:*",
    "@draft-approval/cloudflare-worker": "workspace:*",
    "@draft-approval/config-oxlint": "workspace:*",
    "@patricktree-stack/config-playwright": "workspace:*",
    "@patricktree-stack/config-typescript": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
