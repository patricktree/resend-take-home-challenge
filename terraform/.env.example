# Copy to terraform/.env (gitignored) and fill in; README "Human steps" says where each value comes from.
# Load it into the current shell with: set -a && . terraform/.env && set +a

# Cloudflare API token for Terraform: Account D1 Edit, Workers R2 Storage Edit, Queues Edit.
TF_VAR_cloudflare_api_token=
TF_VAR_cloudflare_account_id=

# The R2 state bucket's S3 endpoint and an R2 API token's S3 credentials (Object Read & Write on resend-challenge-terraform-state).
# Replace ACCOUNT_ID with the Cloudflare account id.
AWS_ENDPOINT_URL_S3=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
