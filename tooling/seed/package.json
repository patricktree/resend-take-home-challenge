{
  "name": "@resend-challenge/seed",
  "private": true,
  "description": "`pnpm seed`: creates Pending, Rejected and Approved Drafts on the local `pnpm dev` Worker through the typed client",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "start": "node ./src/cli.ts",
    "turbo:build": "del-cli --dot=true \"dist/types\" \"dist/tsconfig.build.tsbuildinfo\" && tsc --build ./tsconfig.json",
    "turbo:lint": "oxlint .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix"
  },
  "dependencies": {
    "@resend-challenge/api.client": "workspace:*",
    "@resend-challenge/api.routes": "workspace:*"
  },
  "devDependencies": {
    "@patricktree-stack/config-typescript": "workspace:*",
    "@resend-challenge/config-oxlint": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
